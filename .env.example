# ============================================================
#  Blackboard Bot - configuracion
#  Copia este archivo como .env y completa los valores.
# ============================================================

# Token que te da @BotFather en Telegram (obligatorio).
BOT_TOKEN=

# Opcional: tu chat_id de Telegram. Si lo dejas vacio, el primer
# usuario que envie /start queda registrado como dueno del bot.
# Puedes obtenerlo con @userinfobot.
OWNER_CHAT_ID=

# ------------------------------------------------------------
#  Blackboard / SENATI
# ------------------------------------------------------------
BB_BASE_URL=https://senati.blackboard.com

# Proveedor SAML. Si lo dejas vacio se deduce del dominio del correo:
#   @senati.pe      -> _5702_1  (Microsoft 365 SENATI)
#   @senati.edu.pe  -> _1502_1
# Solo rellenalo si el login automatico elige el proveedor equivocado.
BB_SAML_APID=

BB_TIMEZONE=America/Lima

# Opcional (mas seguro): credenciales para que el bot inicie sesion sin
# que pases la contrasena por Telegram. Quedan en texto plano en .env,
# pero nunca se envian a Telegram. Si las defines, no hace falta /login.
# BB_EMAIL=nombre.apellido@senati.pe
# BB_PASSWORD=

# ------------------------------------------------------------
#  Navegador para el login con Microsoft
# ------------------------------------------------------------
# 0 = ventana visible (recomendado: Microsoft acepta mejor el login)
# 1 = ventana oculta (mas rapido, pero Microsoft puede bloquearlo)
BB_HEADLESS=0

# chrome | msedge | (vacio = Chromium incluido con Playwright)
BB_BROWSER_CHANNEL=chrome

# ------------------------------------------------------------
#  Revision automatica
# ------------------------------------------------------------
# Cada cuantos minutos revisar tareas nuevas y recordatorios.
# 0 desactiva la revision automatica.
BB_CHECK_INTERVAL_MIN=30

# Carpeta donde se guardan la sesion, la base de datos y la clave
# de cifrado. Por defecto: %LOCALAPPDATA%\BlackboardBot
# BB_DATA_DIR=
